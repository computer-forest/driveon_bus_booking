rules_version = '2';

// Baseline: everything is denied unless a rule below opens it. Each stage
// opens its own collections (and adds tests for them) as it lands.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Role is a server-set custom claim; the client cannot grant itself one.
    // The claim alone is not enough: a token keeps saying "admin" for up to an
    // hour after someone is removed, so the live staff list is checked too
    // (account staff_91XXXXXXXXXX needs an active staff/91XXXXXXXXXX entry).
    function isAdmin() {
      return signedIn()
        && request.auth.token.role == 'admin'
        && request.auth.uid.matches('staff_91[0-9]{10}')
        && get(/databases/$(database)/documents/staff/$(request.auth.uid[6:])).data.active == true;
    }

    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // A customer's own profile. Admins may read it; nobody deletes it from
    // the client (account deletion is a server function that also erases
    // the sign-in and anonymises bookings).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'createdAt', 'updatedAt'])
        && validText(request.resource.data.get('name', ''), 100)
        && validText(request.resource.data.get('email', ''), 200)
        && validText(request.resource.data.get('phone', ''), 20)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt'])
        && validText(request.resource.data.get('name', ''), 100)
        && validText(request.resource.data.get('email', ''), 200)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // --- staff-managed master data (Stage 2) ---------------------------
    // Every staff write must carry who and when, enforced here so the audit
    // trigger on the server can trust it.

    function stamped() {
      return isAdmin()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function hasFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Vendors and drivers hold contact details: staff only. Nothing here is
    // ever deleted, only deactivated.
    match /vendors/{id} {
      allow read: if isAdmin();
      allow create, update: if stamped()
        && hasFields(['name', 'contactPerson', 'phone', 'active'])
        && validText(request.resource.data.name, 120)
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /drivers/{id} {
      allow read: if isAdmin();
      allow create, update: if stamped()
        && hasFields(['name', 'phone', 'vendorId'])
        && validText(request.resource.data.name, 120);
      allow delete: if false;
    }

    // Customers search buses, so any signed-in user may read them. The GPS
    // link is kept apart in busAdmin so they cannot.
    match /buses/{id} {
      allow read: if signedIn();
      allow create, update: if stamped()
        && hasFields(['regNumber', 'vendorId', 'capacity', 'active', 'weeklyAvailability'])
        && validText(request.resource.data.regNumber, 40)
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0 && request.resource.data.capacity <= 100
        && request.resource.data.active is bool
        && request.resource.data.weeklyAvailability is list
        && request.resource.data.weeklyAvailability.size() == 7
        && request.resource.data.get('photos', []) is list
        && request.resource.data.get('photos', []).size() <= 4;
      allow delete: if false;
    }

    match /busAdmin/{id} {
      allow read: if isAdmin();
      allow create, update: if stamped();
      allow delete: if false;
    }

    match /locations/{id} {
      allow read: if signedIn();
      allow create, update: if stamped()
        && hasFields(['city', 'area'])
        && validText(request.resource.data.city, 80)
        && validText(request.resource.data.area, 120);
      allow delete: if isAdmin();
    }

    match /blackouts/{id} {
      allow read: if signedIn();
      allow create, update: if stamped()
        && hasFields(['busId', 'from', 'to'])
        && request.resource.data.from is timestamp
        && request.resource.data.to is timestamp
        && request.resource.data.from <= request.resource.data.to;
      allow delete: if isAdmin();
    }

    match /templates/{id} {
      allow read: if isAdmin();
      allow create, update: if stamped()
        && hasFields(['name', 'channel', 'trigger', 'preview'])
        && validText(request.resource.data.preview, 2000);
      allow delete: if false;
    }

    match /packages/{id} {
      allow read: if signedIn();
      allow create, update: if stamped() && hasFields(['city', 'packages']) && request.resource.data.packages is list;
      allow delete: if isAdmin();
    }

    match /faqs/{id} {
      allow read: if signedIn();
      allow create, update: if stamped() && hasFields(['question', 'answer']);
      allow delete: if isAdmin();
    }

    // The Terms & Conditions and Privacy Policy (documents `terms` and
    // `privacy`). Public to read: they are shown before anyone has signed in.
    match /legal/{kind} {
      allow read: if true;
      allow create, update: if stamped()
        && kind in ['terms', 'privacy']
        && hasFields(['sections'])
        && request.resource.data.sections is list
        && request.resource.data.sections.size() <= 40;
      allow delete: if false;
    }

    // One document, config/app: hold length, buffers, advance %, contact numbers.
    match /config/{id} {
      allow read: if signedIn();
      allow create, update: if stamped()
        && hasFields(['holdMinutes', 'defaultAdvancePercent', 'capacities'])
        && request.resource.data.holdMinutes is int
        && request.resource.data.holdMinutes >= 1 && request.resource.data.holdMinutes <= 1440
        && request.resource.data.defaultAdvancePercent is int
        && request.resource.data.defaultAdvancePercent >= 0 && request.resource.data.defaultAdvancePercent <= 100
        && request.resource.data.capacities is list;
      allow delete: if false;
    }

    // The staff allow-list (document id = 91 + the 10-digit number). Staff can
    // see who has access; changes go through the manageStaff function, which
    // checks them, so nothing is written from the app.
    match /staff/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Written only by the server (functions/src/audit.ts) when a staff write
    // lands, so it cannot be skipped or forged from the app.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // A customer's last searched locations.
    match /users/{uid}/recents/{locationId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // --- bookings and money (Stage 4/5) --------------------------------
    // Nothing here is ever written from the app: holds, stage changes and
    // payments go through Cloud Functions, which check availability and
    // which stage a step is legal from.

    function ownsBooking(bookingId) {
      return signedIn()
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid;
    }

    // A customer sees their own bookings; staff see all. (Customers cannot
    // see each other's, which is why search runs on the server.)
    match /bookings/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if isAdmin() || ownsBooking(resource.data.bookingId);
      allow write: if false;
    }

    match /ratings/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['bookingId', 'bus', 'driver', 'overall', 'feedback', 'customerId', 'createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && ownsBooking(request.resource.data.bookingId)
        && request.resource.data.overall is int
        && request.resource.data.overall >= 1 && request.resource.data.overall <= 5
        && request.resource.data.bus is int
        && request.resource.data.bus >= 1 && request.resource.data.bus <= 5
        && request.resource.data.driver is int
        && request.resource.data.driver >= 1 && request.resource.data.driver <= 5
        && validText(request.resource.data.get('feedback', ''), 1000);
      allow update, delete: if false;
    }

    match /cancellations/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.requestedBy == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['bookingId', 'requestedBy', 'reason', 'status', 'createdAt'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && ownsBooking(request.resource.data.bookingId)
        && validText(request.resource.data.get('reason', ''), 500);
      allow update, delete: if false;
    }

    // The in-app inbox. Written only by the server; a person reads their own
    // and may mark them read, nothing else.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    // Phones that should receive this person's push notifications. The token
    // is the document id.
    match /users/{uid}/devices/{token} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // Searches that found no bus, for the reports. Written by the server.
    match /searchMisses/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // busLocks and counters are the server's own bookkeeping.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
